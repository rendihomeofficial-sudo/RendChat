rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
             .hasAny([request.auth.uid]);
    }

    // Chat attachments (used by StorageService: chats/{chatId}/{fileName})
    match /chats/{chatId}/{fileName} {
      allow read: if isSignedIn() && isChatParticipant(chatId);
      allow write: if isSignedIn()
                   && isChatParticipant(chatId)
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isSignedIn() && isChatParticipant(chatId);
    }

    // Chat attachments legacy path (chat-media/{chatId}/{userId}/{fileName})
    match /chat-media/{chatId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && isChatParticipant(chatId)
                   && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Profile avatars (used by StorageService: users/{userId}/avatar.jpg)
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Profile avatars legacy path (avatars/{userId}/{fileName})
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Status / Stories media (used by StorageService: statuses/{userId}/{fileName})
    match /statuses/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 30 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
